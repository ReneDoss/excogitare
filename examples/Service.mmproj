          "y": -28.479249999999865,
          "text": "",
          "html": "<!DOCTYPE HTML><html><body style=\"font-family:'Segoe UI';font-size:10pt;\"><p><b>Wichtige Abhängigkeit</b><br/>Hotel und Anreise erst buchen, wenn<br/><span style='color:#8a5a00;'><b>Freigabe + Liefertermin + Maschinenfenster</b></span><br/>bestätigt sind.</p></body></html>",
          "color": "#4b5a53",
