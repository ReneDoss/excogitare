        },
        "drawing-22a69b30-94d3-47a5-91e1-6863b4de23e2": {
          "id": "drawing-22a69b30-94d3-47a5-91e1-6863b4de23e2",
          "type": "text",
          "x": 265.32003976093745,
          "y": -308.376108316406,
          "text": "",
          "html": "<!DOCTYPE HTML><html><body style=\"font-family:'Segoe UI';font-size:10pt;\">\n<p><span style=\"font-size:15pt;font-weight:600;\">Sanierungsbudget – erste Schätzung</span></p>\n<table cellspacing=\"5\">\n<tr><td><b>Dach inkl. Dämmung</b></td><td align=\"right\">35.000 €</td></tr>\n<tr><td>Heizung / Wärmepumpe</td><td align=\"right\">22.000 €</td></tr>\n<tr><td>Elektrik komplett</td><td align=\"right\">18.000 €</td></tr>\n<tr><td>Fenster</td><td align=\"right\">20.000 €</td></tr>\n<tr><td>Fassade / Putz</td><td align=\"right\">28.000 €</td></tr>\n<tr><td>Bad & Küche</td><td align=\"right\">15.000 €</td></tr>\n<tr><td><span style=\"color:#2e7d32;\">Eigenleistung</span></td><td align=\"right\"><span style=\"color:#2e7d32;\">−12.000 €</span></td></tr>\n<tr><td>Reserve</td><td align=\"right\">25.000 €</td></tr>\n<tr><td><b>Gesamt</b></td><td align=\"right\"><b>151.000 €</b></td></tr>\n</table></body></html>",
          "color": "#37474f",
          "z": 4.0,
          "anchor_object_id": null,
          "offset_x": 0.0,
          "offset_y": 0.0
        },
        "drawing-71963110-300d-4702-9c2e-bd8f5479730b": {
          "id": "drawing-71963110-300d-4702-9c2e-bd8f5479730b",
          "type": "text",
          "x": -685.2470187500002,
          "y": -229.5741062499999,
          "text": "",
          "html": "<!DOCTYPE HTML><html><body style=\"font-family:'Segoe UI';font-size:10pt;\">\n<p><span style=\"font-size:14pt;font-weight:600;\">Besichtigungsprotokoll</span><br/>\n<b>Positiv</b><br/>• ruhige Lage<br/>• Grundstück gut nutzbar<br/>• Dachfläche für PV interessant<br/><br/>\n<b>Offene Fragen</b><br/>• Wann wurde das Dach zuletzt gemacht?<br/>• Ursache der Kellerfeuchte?<br/>• Gibt es Altlasten im Boden?</p></body></html>",
          "color": "#37474f",
          "z": 4.0,
          "anchor_object_id": null,
          "offset_x": 0.0,
          "offset_y": 0.0
        },
        "drawing-86699557-2131-41f4-a7f9-dc02eb774bb9": {
          "id": "drawing-86699557-2131-41f4-a7f9-dc02eb774bb9",
          "type": "text",
          "x": 1233.4980124999997,
          "y": -121.36286249999986,
          "text": "",
          "html": "<!DOCTYPE HTML><html><body style=\"font-family:'Segoe UI';font-size:10pt;\">\n<p><span style=\"font-size:14pt;font-weight:600;\">Wirtschaftlicher Rahmen</span><br/>\nKaufpreis: <b>240.000 €</b><br/>\nNebenkosten: 25.000 €<br/>\nSanierung: 151.000 €<br/><br/>\nProjekt gesamt: <b>416.000 €</b><br/>\nMaximalbudget: <b>430.000 €</b><br/>\n<span style=\"color:#2e7d32;\">Puffer: 14.000 €</span><br/><br/>\n<b>Entscheidung:</b> Nachverhandeln</p></body></html>",
          "color": "#37474f",
          "z": 4.0,
          "anchor_object_id": null,
          "offset_x": 0.0,
          "offset_y": 0.0
        },
        "drawing-0f4701ef-98bf-4118-9462-8c4d0c47f2e0": {
          "id": "drawing-0f4701ef-98bf-4118-9462-8c4d0c47f2e0",
          "type": "text",
          "x": 760.0,
          "y": -35.888699999999915,
          "text": "",
          "html": "<!DOCTYPE HTML><html><body style=\"font-family:'Segoe UI';font-size:10pt;\">\n<p><span style=\"font-size:14pt;font-weight:600;\">Nächste Schritte</span><br/>\n1. Dachdecker zur Zweitbesichtigung<br/>\n2. Energieberater einbinden<br/>\n3. Zwei Elektriker-Angebote einholen<br/>\n4. Finanzierung mit Sanierungspuffer prüfen<br/>\n5. Kaufpreis nachverhandeln</p></body></html>",
          "color": "#37474f",
          "z": 4.0,
          "anchor_object_id": null,
          "offset_x": 0.0,
          "offset_y": 0.0
        }
