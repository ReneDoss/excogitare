        "drawing-860e5ff5-7cc8-4b39-8816-260e011077cc": {
          "id": "drawing-860e5ff5-7cc8-4b39-8816-260e011077cc",
          "type": "rectangle",
          "x": 1170.0,
          "y": -860.0,
          "width": 498.55196249999926,
          "height": 952.6973312499999,
          "fill_color": "#eef3f2",
          "border_color": "#b8cbc7",
          "border_width": 1.1,
          "opacity": 0.08,
          "z": -25,
